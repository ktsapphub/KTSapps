# Copy to .env for local dev. In production set these in your host's dashboard.
# UMAMI_API_KEY and STATS_PASSWORD are secrets — never commit real values.

# ---- Umami Cloud (what KTSapps uses) ----
# Create the key at: Umami → profile menu → Settings → API keys → Create key
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=e95cf66f-d447-4b22-af77-41752a1daf44

# Optional. Defaults to https://api.umami.is/v1 when UMAMI_API_KEY is set.
# Set to https://api.umami.is/v1/eu if your Umami account is in the EU region.
# UMAMI_API_URL=

# ---- Self-hosted Umami instead? Delete UMAMI_API_KEY above and use these ----
# UMAMI_HOST=https://analytics.ktsapps.com
# UMAMI_USERNAME=
# UMAMI_PASSWORD=

# ---- The password you type at /stats ----
STATS_PASSWORD=change-me
